# Large Data files (track .gitkeep, ignore data dumps)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.csv
*.parquet
*.jsonl
*.zip
*.tar.gz

# Serialized models and large binaries (track .gitkeep)
models/*
!models/.gitkeep
*.pkl
*.joblib
*.onnx
*.bin

# Docker & logs
*.log
docker-compose.override.yml
